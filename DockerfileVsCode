FROM linuxserver/code-server:latest

RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh nodejs npm git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Configure default user settings directory
ENV HOME=/config

# inside your llamabot-vscode image build
RUN usermod -u 1000 abc && groupmod -g 1000 abc

# Pre-create necessary directories
RUN mkdir -p /config/data/User

# ---------------------------------------------------------------------------
# Claude Code extension
#
# Do NOT install into /config — that path is the `code_config` named volume, so
# anything baked there is masked on every existing install. Instead we stage the
# .vsix in /opt and let /custom-cont-init.d install it on each boot (see
# vscode/custom-cont-init.d/10-preinstall-extensions.sh).
#
# The platform-specific VSIX bundles the `claude` native binary
# (resources/native-binary/claude), so no separate CLI install is needed.
# Bump CLAUDE_CODE_VERSION from https://open-vsx.org/extension/Anthropic/claude-code
# ---------------------------------------------------------------------------
ARG TARGETARCH
ARG CLAUDE_CODE_VERSION=2.1.220
RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) CC_PLATFORM=linux-x64 ;; \
        arm64) CC_PLATFORM=linux-arm64 ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mkdir -p /opt/preinstalled-extensions; \
    curl -fsSL -o /opt/preinstalled-extensions/anthropic.claude-code.vsix \
        "https://open-vsx.org/api/Anthropic/claude-code/${CC_PLATFORM}/${CLAUDE_CODE_VERSION}/file/Anthropic.claude-code-${CLAUDE_CODE_VERSION}@${CC_PLATFORM}.vsix"

COPY vscode/custom-cont-init.d/ /custom-cont-init.d/
RUN chmod +x /custom-cont-init.d/*.sh

# NOTE: we do not write /config/data/User/settings.json here. That path is
# inside the code_config volume, so the volume hides anything baked at build
# time. The user's own VS Code settings are the only settings that apply.

# Set up a default git config (can be overridden by user)
RUN git config --system credential.helper store && \
    git config --system --add safe.directory '*'

RUN echo '\
if [ -t 1 ]; then \
  if ! ssh -q Leonardo exit 2>/dev/null; then \
    echo "⚠️  SSH connection to 'Leonardo' failed." \
         "To set it up, run:" \
         "bash bin/install/setup-ssh-for-vscode-container.sh"; \
  fi; \
fi' > /etc/profile.d/check_ssh.sh

# 🧨 Silence all browser console logs
RUN sed -i '1s|^|<script>for(const k of ["log","debug","info","warn","error"])console[k]=()=>{};</script>\n|' \
    /app/code-server/lib/vscode/out/vs/code/browser/workbench/workbench.html

